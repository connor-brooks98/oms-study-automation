            "description": "Successful Response"
          },
          "401": {
            "description": "Token missing, invalid or revoked"
          },
          "403": {
            "description": "Required capability was not granted"
          },
          "404": {
            "description": "Not found within the authorized notebook"
          },
          "409": {
            "description": "Identity or revision conflict"
          },
          "413": {
            "description": "Import exceeds limits"
          },
          "429": {
            "description": "Rate limit: retry after Retry-After seconds"
