{
  "$defs": {
    "BoardQuestionDraft": {
      "additionalProperties": false,
      "properties": {
        "blueprint_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blueprint Tags",
          "type": "array"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QuestionClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "correct_option_id": {
          "minLength": 1,
          "title": "Correct Option Id",
          "type": "string"
        },
        "difficulty": {
          "maximum": 5,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        },
        "lead_in": {
          "minLength": 1,
          "title": "Lead In",
          "type": "string"
        },
        "objective_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Objective Ids",
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "maxItems": 5,
          "minItems": 4,
          "title": "Options",
          "type": "array"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        }
      },
      "required": [
        "stem",
        "lead_in",
        "options",
        "correct_option_id",
        "objective_ids",
        "difficulty"
      ],
      "title": "BoardQuestionDraft",
      "type": "object"
    },
    "QuestionClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/QuestionClaimRole"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "role",
        "text",
        "evidence_ids"
      ],
      "title": "QuestionClaim",
      "type": "object"
    },
    "QuestionClaimRole": {
      "enum": [
        "stem",
        "correct_support",
        "distractor_support",
        "rationale",
        "teaching_point"
      ],
      "title": "QuestionClaimRole",
      "type": "string"
    },
    "QuestionMode": {
      "enum": [
        "lecture_recall",
        "lecture_application",
        "board_style",
        "integrated_board_style",
        "comlex_omm",
        "remediation",
        "timed_mixed_block"
      ],
      "title": "QuestionMode",
      "type": "string"
    },
    "QuestionOption": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "option_id": {
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "text",
        "rationale",
        "evidence_ids"
      ],
      "title": "QuestionOption",
      "type": "object"
    },
    "QuestionStatus": {
      "enum": [
        "draft",
        "validating",
        "quarantined",
        "approved",
        "retired"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "QuestionValidationResult": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Codes",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "QuestionValidationResult",
      "type": "object"
    },
    "QuestionVersion": {
      "additionalProperties": false,
      "properties": {
        "draft": {
          "$ref": "#/$defs/BoardQuestionDraft"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/QuestionMode"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "output_hash": {
          "title": "Output Hash",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Revision Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "draft"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "question_id",
        "version",
        "mode",
        "draft",
        "source_revision_ids",
        "prompt_version",
        "schema_version",
        "model_version",
        "input_hash",
        "output_hash"
      ],
      "title": "QuestionVersion",
      "type": "object"
    }
  },
  "$id": "question-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/BoardQuestionDraft"
    },
    {
      "$ref": "#/$defs/QuestionValidationResult"
    },
    {
      "$ref": "#/$defs/QuestionVersion"
    }
  ]
}
