OMS_HUB_DATA_DIR=C:\ProgramData\OMSStudyHub
OMS_HUB_DATABASE_URL=sqlite:///C:/ProgramData/OMSStudyHub/hub.db
OMS_HUB_TIMEZONE=America/New_York
OMS_HUB_DASHBOARD_HOST=127.0.0.1
OMS_HUB_DASHBOARD_PORT=8787
OMS_HUB_STUDY_ROOT=%USERPROFILE%\Documents\OMS II
OMS_HUB_ICLOUD_STAGING_ROOT=
OMS_HUB_OFFICE_TIMEOUT_SECONDS=180
OMS_HUB_DOCUMENT_PARSER_MODE=shadow
OMS_HUB_MAX_UPLOAD_FILE_BYTES=104857600
OMS_HUB_MAX_UPLOAD_BATCH_BYTES=524288000
OMS_HUB_UPLOAD_SESSION_HOURS=24
# Required. Study Hub does not ship a bundled prompt path; point this at a
# prompt file on your machine (or run `oms-hub prompt-initialize` first).
OMS_HUB_TRANSCRIPT_PROMPT_PATH=C:\Users\conbr\Documents\Main Vault\Anki AI Prompts\Transcript Cleaning.md
OMS_HUB_TRANSCRIPT_PROMPT_SHA256=
OMS_HUB_TRANSCRIPT_MIN_CLEAN_RATIO=0.60
OMS_HUB_TRANSCRIPT_MAX_CLEAN_RATIO=1.25
OMS_HUB_OPENAI_MODEL=gpt-5.2
OMS_HUB_OPENAI_INPUT_USD_PER_MILLION=2.50
OMS_HUB_OPENAI_OUTPUT_USD_PER_MILLION=15.00
OMS_HUB_PUBLIC_HOSTNAME=
OMS_HUB_CLOUDFLARE_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
OMS_HUB_CLOUDFLARE_ACCESS_AUDIENCE=
OMS_HUB_CLOUDFLARE_ACCESS_ALLOWED_EMAIL=
OMS_HUB_ALLOW_LOCAL_ACCESS=true
# JSON mapping. New grounded-learning flags default off; legacy NotebookLM
# generation remains enabled unless explicitly set to false.
OMS_HUB_FEATURE_FLAGS={}
OMS_HUB_ANKI_ENABLED=false
OMS_HUB_ANKI_DATA_DIR=C:\ProgramData\OMSStudyHub\anki
OMS_HUB_ANKI_AGENT_HOSTNAME=
OMS_HUB_ANKI_AGENT_TOKEN_KEY=anki-agent-token
OMS_HUB_ANKI_AGENT_MAX_REQUEST_BYTES=104857600
OMS_HUB_ANKI_WORKER_POLL_SECONDS=5
OMS_HUB_ANKI_WORKER_LEASE_SECONDS=120
OMS_HUB_ANKI_WORKER_MAX_STAGE_ATTEMPTS=3
OMS_HUB_ANKI_PROMPT_DIRECTORY=
OMS_HUB_ANKI_PROMPT_GIT_SYNC=false
OMS_HUB_ANKI_PROMPT_GIT_TIMEOUT_SECONDS=30
# Optional private, immutable Lecture07 S4 validation artifact. Do not add the
# artifact to Git. Set both values only after installing the separately supplied
# fixture and recording its exact SHA-256; without both, the UI keeps the
# fixture-test button unavailable and cheaper S4/S6 defaults remain gated.
OMS_HUB_ANKI_FIXTURE_ARTIFACT_PATH=
OMS_HUB_ANKI_CARD_CENTRIC_FIXTURE_SHA256=
OMS_HUB_ANKI_FOCUSED_RETRIEVAL_LIMIT=200
OMS_HUB_ANKI_GLOBAL_RETRIEVAL_LIMIT=50
OMS_HUB_ANKI_SEMANTIC_MODEL=voyage-4-large
OMS_HUB_ANKI_SEMANTIC_DIMENSIONS=1024
OMS_HUB_ANKI_SEMANTIC_MIN_COVERAGE=0.995
OMS_HUB_ANKI_SEMANTIC_BATCH_SIZE=128
OMS_HUB_ANKI_SEMANTIC_QUERY_CACHE_SIZE=512
# Keep this only in your untracked .env file. It takes precedence over the
# Windows Credential Manager value set by `oms-hub.exe voyage-set-key`.
VOYAGE_API_KEY=
# Keep this URL on loopback. The default AnkiConnect port is 8765; a distinct
# port such as 8766 is supported when another local service already owns 8765.
OMS_HUB_ANKI_CONNECT_URL=http://127.0.0.1:8765
OMS_HUB_ANKI_EXECUTABLE_PATH=C:\Program Files\Anki\anki.exe
OMS_HUB_ANKI_STARTUP_ATTEMPTS=20
OMS_HUB_ANKI_STARTUP_POLL_SECONDS=1
