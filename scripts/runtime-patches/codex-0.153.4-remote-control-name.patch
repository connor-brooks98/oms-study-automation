+#[cfg(not(windows))]
+fn remote_control_server_name() -> String {
+    gethostname().to_string_lossy().trim().to_string()
+}
+
+#[cfg(windows)]
+fn remote_control_server_name() -> String {
+    use winapi_util::sysinfo::ComputerNameKind;
+    use winapi_util::sysinfo::get_computer_name;
+
+    remote_control_display_name(get_computer_name(ComputerNameKind::PhysicalDnsHostname))
+}
+
+#[cfg(any(windows, test))]
+fn remote_control_display_name(hostname: io::Result<std::ffi::OsString>) -> String {
+    // This is a display label, not the hostname used to select configuration policy.
+    hostname
+        .ok()
+        .map(|name| name.to_string_lossy().trim().to_string())
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| "Codex app-server".to_string())
+}
