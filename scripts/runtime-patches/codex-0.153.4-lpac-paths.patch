+#[cfg(all(windows, any(not(debug_assertions), test)))]
+fn prepare_windows_home_for_aliases(codex_home: &Path, temp_root: &Path) -> std::io::Result<()> {
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    // find_codex_home already rejects missing explicit overrides. Preserve first-use
+    // default-home creation, but create no helper files before the containment check.
+    std::fs::create_dir_all(codex_home)?;
+    let codex_home = AbsolutePathBuf::from_absolute_path(codex_home.canonicalize()?)?;
+    let temp_root = AbsolutePathBuf::from_absolute_path(temp_root.canonicalize()?)?;
+    if codex_home.starts_with(temp_root.as_path()) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!(
+                "Refusing to create helper binaries under temporary dir {temp_root:?} (codex_home: {codex_home:?})"
+            ),
+        ));
+    }
+    Ok(())
+}
