<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omsstudy.anki-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__EXECUTABLE__</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OMS_ANKI_AGENT_HUB_URL</key>
    <string>__HUB_URL__</string>
    <key>OMS_ANKI_AGENT_AGENT_ID</key>
    <string>__AGENT_ID__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/anki-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/anki-agent.error.log</string>
</dict>
</plist>
